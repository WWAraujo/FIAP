LOG_LEVEL=INFO

# Provedor padrão usado quando a chamada não especifica um explicitamente.
# Trocado para ollama enquanto não há créditos no Gemini.
LLM_PROVIDER=ollama
#LLM_PROVIDER=google

# Google Gemini (mantido configurado para quando voltar a ter créditos)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash

# Ollama local — host.docker.internal em vez de localhost, porque a
# chamada sai de dentro do container Docker, não do seu Windows
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5